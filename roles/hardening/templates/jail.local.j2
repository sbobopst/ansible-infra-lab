# jail.local — managed by Ansible
# Overrides defaults in /etc/fail2ban/jail.conf

[DEFAULT]
bantime  = {{ hardening_fail2ban_bantime }}
findtime = {{ hardening_fail2ban_findtime }}
maxretry = {{ hardening_fail2ban_maxretry }}

# Email notifications (disabled by default in lab)
destemail = root@localhost
sendername = Fail2Ban
action = %(action_)s

[sshd]
enabled  = true
port     = {{ hardening_ssh_port }}
filter   = sshd
logpath  = /var/log/auth.log
maxretry = {{ hardening_fail2ban_maxretry }}
